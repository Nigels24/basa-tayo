{
  "expo": {
    "name": "Basa Tayo!",
    "slug": "basa-tayo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "basatayo",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "imageWidth": 200,
      "resizeMode": "contain",
      "backgroundColor": "#ffc53d"
    },
    "android": {
      "package": "ph.edu.jhcsc.basatayo",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffc53d"
      },
      "permissions": [
        "INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-audio",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e42ede15-3424-41da-a09d-d065803684c9"
      }
    },
    "owner": "jsipe072"
  }
}

# PostgreSQL — Neon, Supabase or a local database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/basatayo?schema=public"

# Signing key for JSON Web Tokens — change this
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="30d"

PORT=3000

# Cloudinary (pictures and letter-sound recordings)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Teacher sign-up (/register). Teachers need this code to create an account;
# the researchers give it out at orientation. Empty or missing = sign-up CLOSED.
# Set the real value only on Render, never in the repo.
TEACHER_REGISTRATION_CODE=""
